# ==============================================================================
# CropGuard / DEMETER Multi-Provider FREE AI API Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your own free API keys obtained from the
# official provider portals. Never commit your actual .env file to Git!
# ==============================================================================

# [1] Groq API Key (PRIMARY - Ultra-fast Llama-3.3 / Qwen inference)
# Obtain free key at: https://console.groq.com/keys
GROQ_API_KEY=

# [2] Google Gemini API Key (SECONDARY - Free tier on Google AI Studio)
# Obtain free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# [3] OpenRouter API Key (FALLBACK 1 - Access to free models ending with :free)
# Obtain free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# [4] Mistral AI API Key (FALLBACK 2 - Free experiment tier on La Plateforme)
# Obtain free key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# [5] Hugging Face Access Token (FALLBACK 3 - Free Serverless Inference API)
# Obtain free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Optional Router Settings
AI_ROUTER_TIMEOUT=12
AI_ROUTER_MAX_RETRIES=2
